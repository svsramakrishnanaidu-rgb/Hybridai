# Copy to .env.local and fill in. Never commit real keys.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
TAVILY_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

HYDRO_MAX_CALLS=6
HYDRO_BUDGET_USD=0.12

# AI workspace (device execution)
# Root of HYDRO's own storage. Defaults to .data/ai-home inside the project.
HYDRO_AI_HOME=
# Hard storage ceiling for the AI home, in MB.
HYDRO_HOME_QUOTA_MB=512
# Where the permission level is stored (defaults to .data/execution-permissions.json).
HYDRO_PERM_FILE=
